{
  "name": "@henadev/opencode-anthropic-auth",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hena-dev/opencode-anthropic-auth.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun scripts/dev.ts",
    "dev:clean": "bun scripts/dev-clean.ts",
    "extract": "bun scripts/extract-system-prompt.ts",
    "test": "bun test",
    "types": "tsc",
    "format": "biome check --write --unsafe",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "change": "changeset",
    "release": "bun run build && bun change publish"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "dedent": "^1.7.2",
    "lefthook": "2.1.9",
    "typescript": "6.0.3"
  }
}
